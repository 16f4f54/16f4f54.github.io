# Skopiuj ten plik jako .env i uzupełnij dane:
#   cp .env.example .env

# Dane logowania do Autoplac.pl (opcjonalne – można podać w formularzu)
AUTOPLAC_EMAIL=twoj@email.pl
AUTOPLAC_PASSWORD=twoje_haslo

# Katalog do zapisu pobranych zdjęć (domyślnie: ./static/zdjecia)
# PHOTO_DIR=./static/zdjecia

# Klucz sesji Flask (zostanie wygenerowany automatycznie jeśli pominięty)
# FLASK_SECRET=jakis-tajny-klucz
